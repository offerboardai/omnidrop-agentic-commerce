# Copy to .env and fill from Circle Developer / Agent Stack docs.
# Never commit .env

# Set true until real Circle credentials + funded wallet are ready
DRY_RUN=true

# Agent wallets (from `circle wallet create` / starter kit)
BUYER_AGENT_WALLET_ADDRESS=
SELLER_AGENT_WALLET_ADDRESS=

# Optional: path to circle CLI if not on PATH
# CIRCLE_CLI=circle

# Chain / explorer (fill to match your wallet network)
# Prize spike: prefer testnet first (BASE-SEPOLIA or ARC-TESTNET)
# Mainnet proof later: BASE + https://basescan.org/tx
CIRCLE_CHAIN=BASE-SEPOLIA
BLOCK_EXPLORER_TX_BASE_URL=https://sepolia.basescan.org/tx

# Demo subscription pricing (USDC decimal string)
SUBSCRIPTION_PRICE_USDC=0.01
SUBSCRIPTION_NAME=OmniDROP Encrypted Weekly Brief
